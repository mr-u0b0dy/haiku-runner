menu "Audio Output"

config HR_BACKEND_STUB
  bool "Enable stub backend"
  default y

config HR_BACKEND_I2S
  bool "Enable I2S output backend"
  select I2S
  default n
  help
    Drives audio frames from the pipeline out over I2S (e.g. to a MAX98357A).
    Selects the I2S driver, which the backend needs unconditionally: both
    audio_backend_init() and audio_backend_write() talk to the peripheral,
    not just the optional self-test melody below.

if HR_BACKEND_I2S

config HR_BACKEND_I2S_TEST_TONE
  bool "Play a self-test melody on I2S backend start"
  default n
  help
    Writes a short synthesized melody ("Jingle Bells" opening verse) directly
    to the I2S peripheral when the backend starts, independent of any input
    source or pipeline frames. Use this to verify board-to-amp wiring (e.g.
    MAX98357A) before relying on the full audio pipeline.

endif # HR_BACKEND_I2S

config HR_PIPELINE_SOF
  bool "Use SOF pipeline adapter"
  default n

choice HR_DEFAULT_INPUT
  prompt "Default selected input"
  default HR_DEFAULT_INPUT_BLE

config HR_DEFAULT_INPUT_BLE
  bool "BLE"

config HR_DEFAULT_INPUT_AUX
  bool "AUX"

config HR_DEFAULT_INPUT_USB_C
  bool "USB Type-C"

config HR_DEFAULT_INPUT_WIFI
  bool "Wi-Fi"

endchoice

endmenu
