/ {
  chosen {
    zephyr,console = &uart0;
  };

  aliases {
    i2s-tx = &i2s0;
  };
};

/* I2S0 wired to a MAX98357A: BCLK=P1.15/D13, LRCLK=P1.12/D10, DIN=P1.13/D11.
 * See docs-site/content/test-hardware/max98357a-wiring.md for the pin table. */
&pinctrl {
  i2s0_default_alt: i2s0_default_alt {
    group1 {
      psels = <NRF_PSEL(I2S_SCK_M, 1, 15)>,
              <NRF_PSEL(I2S_LRCK_M, 1, 12)>,
              <NRF_PSEL(I2S_SDOUT, 1, 13)>;
    };
  };
};

&hfclkaudio {
  hfclkaudio-frequency = <11289600>;
};

&i2s0 {
  status = "okay";
  pinctrl-0 = <&i2s0_default_alt>;
  pinctrl-names = "default";
  clock-source = "ACLK";
};
